node_modules/
# demo recordings (record.mjs, POST /api/demo/record)
.tmp/recordings/
# P16's scratch: the probe scripts, the before/after recording pairs and the
# per-scene shoots used to compare them. The PUBLISHABLE recordings are
# assets/demo/<id>/demo.mp4; what is under here is working material and ~90 MB
# of superseded video.
.tmp/p16/
# local dev state: throwaway MinIO data, the local media fallback, logs
.tmp/minio-data/
.tmp/logs/
server/.media/
server/.env
# per-tenant workspace cache and the SDK config dir (P2)
server/.workspaces/
.tmp/sdk-home/
# the capability-synthesis loop's staging root (P5): a synthesised connector is
# a build product, promoted into the catalog when it has earned its uses
server/connectors/staged/
# the session tier's per-tenant browser profiles and the vault's dev master key
server/.sessions/
server/.vault-key
